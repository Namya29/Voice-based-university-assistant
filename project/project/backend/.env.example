# Copy this file to .env and fill in real values. Never commit the real .env file.

# -- Server --------------------------------------------------
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- Microsoft Foundry (Azure AI Foundry project) -------------
FOUNDRY_PROJECT_ENDPOINT=https://voice-baseduniversityassistant.services.ai.azure.com/api/projects/Voice-BasedUniversityAssistant
FOUNDRY_API_KEY=REPLACE_WITH_ROTATED_KEY
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -- Azure AI Search -------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=REPLACE_WITH_SEARCH_ADMIN_OR_QUERY_KEY
AZURE_SEARCH_INDEX=university-docs
AZURE_SEARCH_TOP_K=5
AZURE_SEARCH_MIN_SCORE=0.72

# -- Azure Speech ------------------------------------------------
AZURE_SPEECH_KEY=REPLACE_WITH_SPEECH_KEY
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_TOKEN_TTL_SECONDS=600

# -- Supported languages (BCP-47) for auto language detection --
SUPPORTED_LANGUAGES=en-US,hi-IN,es-ES,fr-FR,ar-SA,zh-CN
